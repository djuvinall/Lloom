# git-lfs for large artifacts (only relevant if you choose to commit checkpoints)
checkpoints/**/*.pt filter=lfs diff=lfs merge=lfs -text
checkpoints/**/*.model filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text
*.npy filter=lfs diff=lfs merge=lfs -text

# HollowDeck module: files vendored byte-for-byte from the HollowDeck checkout
# (hollowdeck/lloom/VENDORED.json records their sha256). No line-ending
# normalization, or a Windows checkout with core.autocrlf rewrites them to CRLF
# and they stop matching upstream. Keep these lines last (last match wins).
hollowdeck/lloom/vendor/guard.py -text linguist-vendored
hollowdeck/lloom/vendor/assets.py -text linguist-vendored
hollowdeck/lloom/vendor/proc.py -text linguist-vendored
hollowdeck/lloom/static/vendor/** -text linguist-vendored
